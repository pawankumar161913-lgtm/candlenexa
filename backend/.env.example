# ---- CandleNexa backend environment ----
# Copy this file to .env (same folder as requirements.txt) and fill in values.
# NEVER commit .env and never expose these values to the frontend.

# Security: generate with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite by default; PostgreSQL example below)
DATABASE_URL=sqlite:///./candlenexa.db
# DATABASE_URL=postgresql+psycopg://candlenexa:candlenexa@localhost:5432/candlenexa

# Market data provider
MARKET_DATA_PROVIDER=twelve_data
TWELVE_DATA_API_KEY=
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# Twelve Data free plan allows ~8 credits/minute and 800/day.
PROVIDER_MIN_INTERVAL_SECONDS=8
PROVIDER_DAILY_CREDIT_BUDGET=700

# Caching (seconds)
CACHE_TTL_SECONDS=60
SERIES_CACHE_TTL_SECONDS=300
ANALYSIS_CACHE_TTL_SECONDS=180

# Rate limiting per client IP
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20

# CORS (the Vite dev server origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

ENV=development
